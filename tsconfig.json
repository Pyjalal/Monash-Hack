{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tools/eval/**/*.ts", "vitest.config.ts"],
  "exclude": ["**/node_modules", "**/dist", "training_data", "apps/extension"]
}
