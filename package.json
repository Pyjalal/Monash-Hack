{
  "name": "cargolens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/eval"
  ],
  "scripts": {
    "gateway:setup": "npx -y vercel@latest ai-gateway setup",
    "dev": "tsx watch apps/api/src/server.ts",
    "start": "tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/extension/tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json && tsc --noEmit -p apps/extraction-dashboard/tsconfig.json",
    "dev:dashboard": "vite apps/dashboard",
    "build:dashboard": "vite build apps/dashboard",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx tools/eval/src/evaluate.ts",
    "eval:final": "tsx tools/eval/src/final.ts",
    "eval:triage": "tsx tools/eval/src/triage.ts",
    "eval:classify": "tsx tools/eval/src/classification.ts",
    "build:extension": "npm run build --workspace @cargolens/extension",
    "submission:classify": "tsx tools/eval/src/submission.ts classify",
    "submission:pipeline": "tsx tools/eval/src/submission.ts pipeline",
    "test:openrouter": "tsx tools/eval/src/openrouter-smoke.ts",
    "dev:extraction-dashboard": "vite apps/extraction-dashboard --config apps/extraction-dashboard/vite.config.ts",
    "build:extraction-dashboard": "vite build apps/extraction-dashboard --config apps/extraction-dashboard/vite.config.ts",
    "submission:extract-all": "tsx tools/eval/src/submission.ts pipeline --all-documents",
    "pipeline:full": "tsx tools/eval/src/full-pipeline.ts",
    "pipeline:report": "tsx tools/eval/src/pipeline-report.ts",
    "demo:rehearse": "tsx tools/demo/src/rehearse.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
