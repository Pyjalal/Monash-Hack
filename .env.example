# Copy to .env. The running API requires DASHBOARD_TOKEN and the key for its selected AI provider.
# AI_PROVIDER selects the Jev transport: typesafe (default) or openrouter.
AI_PROVIDER=typesafe
# Gateway is reserved. OpenRouter also powers optional bounded text recovery.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
TYPESAFE_API_KEY=your_typesafe_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash-lite
RECOVERY_MAX_CASE_ATTEMPTS=3
RECOVERY_MAX_CASE_TOKENS=30000
RECOVERY_MAX_CASE_USD=0.02

# API and local dashboard access. Generate a long random token; keep it server-side.
DASHBOARD_TOKEN=replace_with_a_long_random_local_token
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=runtime/cargolens.sqlite
DATASET_ROOT=training_data/sdoc-hackathon-docker/extracted/data_v2
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TYPESAFE_MODEL=jev-1.13.0
OPENROUTER_MODEL=typesafe/jev-1.13
# Optional separate low-cost model for out-of-template SI/BL extraction.
# It must support the selected provider's typed choice/decision interface.
TYPESAFE_EXTRACTION_MODEL=jev-1.13.0
OPENROUTER_EXTRACTION_MODEL=google/gemma-4-26b-a4b-it:free
JEV_PROMPT_VARIANT=boundaries
JEV_CONCURRENCY=8
JEV_BATCH_SIZE=8
JEV_REQUESTS_PER_MINUTE=1100

# Gmail OAuth (gmail.readonly and gmail.send). Never place these in the extension.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/gmail/oauth/callback
# Optional migration credential; OAuth consent stores the refresh token encrypted in SQLite.
GMAIL_REFRESH_TOKEN=
GMAIL_MAILBOX_ADDRESS=
GMAIL_DOCUMENTATION_CONTACT=
GMAIL_AUTOMATION_ENABLED=false
GMAIL_POLL_ENABLED=false
GMAIL_SYNC_QUERY=in:inbox -in:spam -in:trash
GMAIL_POLL_INTERVAL_MS=30000
GMAIL_ATTACHMENT_ROOT=runtime/gmail-attachments
